{"type": "query", "query_id": "ap03_correlated_subquery", "dataset": "sakila", "tags": ["antipattern", "correlated-subquery"], "original_sql": "SELECT p.payment_id, p.customer_id, p.amount\nFROM payment p\nWHERE p.amount > (SELECT AVG(p2.amount) FROM payment p2 WHERE p2.customer_id = p.customer_id)", "alts": [{"id": "original", "sql": "SELECT p.payment_id, p.customer_id, p.amount\nFROM payment p\nWHERE p.amount > (SELECT AVG(p2.amount) FROM payment p2 WHERE p2.customer_id = p.customer_id)"}, {"id": "c1", "sql": "SELECT p.payment_id, p.customer_id, p.amount\nFROM payment p\nJOIN (\n    SELECT customer_id, AVG(amount) AS avg_amount\n    FROM payment\n    GROUP BY customer_id\n) c ON p.customer_id = c.customer_id\nWHERE p.amount > c.avg_amount"}, {"id": "c2", "sql": "SELECT p.payment_id, p.customer_id, p.amount\nFROM payment p\nWHERE p.amount > (SELECT AVG(p2.amount) FROM payment p2 WHERE p2.customer_id = p.customer_id)\nAND p.customer_id IS NOT NULL"}, {"id": "c3", "sql": "SELECT p.payment_id, p.customer_id, p.amount\nFROM payment p\nWHERE EXISTS (\n    SELECT 1\n    FROM payment p2\n    WHERE p2.customer_id = p.customer_id\n    AND p2.amount < p.amount\n)\nAND p.amount > (SELECT AVG(p2.amount) FROM payment p2 WHERE p2.customer_id = p.customer_id)"}, {"id": "c4", "sql": "SELECT p.payment_id, p.customer_id, p.amount\nFROM payment p\nJOIN (\n    SELECT customer_id, AVG(amount) AS avg_amount\n    FROM payment\n    GROUP BY customer_id\n) c ON p.customer_id = c.customer_id\nWHERE p.amount > c.avg_amount\nAND p.customer_id IS NOT NULL"}, {"id": "c5", "sql": "SELECT p.payment_id, p.customer_id, p.amount\nFROM payment p\nWHERE p.amount > (SELECT AVG(p2.amount) FROM payment p2 WHERE p2.customer_id = p.customer_id)\nAND p.customer_id IN (SELECT customer_id FROM payment GROUP BY customer_id HAVING AVG(amount) IS NOT NULL)"}], "pool_file_sha256": "8aa09c14a3a8f0d5b99d1da6b6e636c92bfbaa40f007c1cc9db85268c4f6402b", "n_proposed": 5, "n_valid": 5, "pool_statuses": ["valid", "valid", "valid", "valid", "valid"]}
