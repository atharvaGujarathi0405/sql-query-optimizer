# Fixed server config shared by every arm (fairness rule 7). Change only
# before an evaluation run, and record the change with the run.
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
# SF1 (~1.1 GB incl. indexes) fits, so runs are not disk-bound.
innodb_buffer_pool_size = 2G
# performance_schema stays ON (default): rows-examined metrics read from it.
performance_schema = ON
