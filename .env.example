# MySQL root password, used only by the container and the init script
MYSQL_ROOT_PASSWORD=change-me-root
# Database the optimizer works against; created on first container start
MYSQL_DATABASE=optimizer
# Comma-separated dataset schemas created at init; both users get grants on these too
DATASET_SCHEMAS=employees,sakila,tpch
# Host the backend connects to (port is bound to localhost only)
MYSQL_HOST=127.0.0.1
# Host port the container is published on and the backend connects to (use 3307 if a local MySQL holds 3306)
MYSQL_PORT=3306
# Admin user: seeding data and index experiments (full privileges on MYSQL_DATABASE)
OPTIMIZER_ADMIN_USER=admin
# Admin user password
OPTIMIZER_ADMIN_PASSWORD=change-me-admin
# Readonly user: executing candidate queries (SELECT only on MYSQL_DATABASE)
OPTIMIZER_READONLY_USER=reader
# Readonly user password
OPTIMIZER_READONLY_PASSWORD=change-me-readonly
